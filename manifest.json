{
  "manifest_version": 3,
  "name": "南科大选课评教助手 (TIS × NCES)",
  "version": "1.1.1",
  "description": "教务系统助手：选课页悬停查看 NCES 评教（评分/评价/教师对比）；成绩页显示每门课排名、悬停查看分项成绩与整体绩点排名。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://ncesnext.com/*",
    "https://*.ncesnext.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://tis.sustech.edu.cn/*"],
      "js": ["card.js", "content.js", "grade.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
